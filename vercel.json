{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "env": {
    "DISCORD_CLIENT_ID": "@discord-client-id",
    "DISCORD_CLIENT_SECRET": "@discord-client-secret",
    "REDIRECT_URI": "@redirect-uri"
  }
}